# Copy this file to game.properties in the engine/android directory.
# Keep applicationId stable after the first public release.
game.applicationId=io.github.creator.game
game.name=Game Title
game.versionCode=1
game.versionName=1.0.0

# Easiest setup: place game.pak beside build.bat. Relative and absolute paths
# also work; use forward slashes in absolute Windows paths.
game.pak=game.pak

# Stable file name used inside the application's Paks directory.
# Keep this unchanged across updates. Scripts may depend on it.
game.pakName=game.pak
